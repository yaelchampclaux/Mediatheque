<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Médiathèque{% endblock %}</title>

    <link rel="icon" href="{{ asset('symfony-logo.svg') }}">

    {% block stylesheets %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
              rel="stylesheet"
              integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC"
              crossorigin="anonymous">
    {% endblock %}
</head>

<body>

{% block menu %}
<nav class="navbar navbar-expand-sm navbar-light bg-light shadow-sm">
    <div class="container-fluid">

        <!-- Logo Symfony -->
        <a class="navbar-brand" href="{{ path('accueil') }}">
            <img src="{{ asset('symfony-logo.svg') }}"
                 alt="Symfony"
                 width="40"
                 class="d-inline-block align-text-top me-2">
            Médiathèque
        </a>

        <ul class="navbar-nav">
            <li class="nav-item"><a class="nav-link" href="{{ path('accueil') }}">Accueil</a></li>
            <li class="nav-item"><a class="nav-link" href="{{ path('app_oeuvre_index') }}">Oeuvres</a></li>
            <li class="nav-item"><a class="nav-link" href="{{ path('app_auteur_index') }}">Auteurs</a></li>
            <li class="nav-item"><a class="nav-link" href="{{ path('app_edition_index') }}">Maison d'édition</a></li>
            <li class="nav-item"><a class="nav-link" href="{{ path('app_serie_index') }}">Séries</a></li>
            <li class="nav-item"><a class="nav-link" href="{{ path('app_type_oeuvre_index') }}">Type Oeuvre</a></li>
            <li class="nav-item"><a class="nav-link" href="{{ path('app_type_auteur_index') }}">Type Auteur</a></li>
            <li class="nav-item"><a class="nav-link" href="{{ path('app_lieu_index') }}">Lieu</a></li>
        </ul>

    </div>
</nav>
{% endblock %}

<div class="container mt-4">
    {% block body %}{% endblock %}
</div>

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
        crossorigin="anonymous"></script>
{% endblock %}

</body>
</html>
