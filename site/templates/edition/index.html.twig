{% extends 'base.html.twig' %}

{% block title %}Edition index{% endblock %}

{% block body %}
    <h1>Edition index</h1>

    <table id="editionTable" class="table display">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Siteweb</th>
                <th>Info</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for edition in editions %}
            <tr>
                <td>{{ edition.id }}</td>
                <td>{{ edition.nom }}</td>
                <td>{{ edition.siteweb }}</td>
                <td>{{ edition.info }}</td>
                <td>
                    <a href="{{ path('edition_show', {'id': edition.id}) }}">Voir</a>
                    <a href="{{ path('edition_edit', {'id': edition.id}) }}">Éditer</a>

                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">pas d'entrées trouvées</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_edition_new') }}">Nouveau</a>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function() {
            $('#editionTable').DataTable();
        });
    </script>
{% endblock %}
