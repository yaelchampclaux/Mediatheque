<form method="post" action="{{ path('app_oeuvre_delete', {'id': oeuvre.id}) }}" 
      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet élément ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ oeuvre.id) }}">
    <button class="btn">Effacer</button>
</form>
