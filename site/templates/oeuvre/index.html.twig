{% extends 'base.html.twig' %}

{% block title %}Liste des œuvres{% endblock %}

{% block body %}
    <h1>Liste des œuvres</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Identifiant</th>
                <th>Titre</th>
                <th>Photo</th>
                <th>Année</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for oeuvre in oeuvres %}
            <tr>
                <td>{{ oeuvre.id }}</td>
                <td>{{ oeuvre.titre }}</td>
                <td>{{ oeuvre.photo }}</td>
                <td>{{ oeuvre.annee }}</td>
                <td>
                    <a href="{{ path('app_oeuvre_show', {'id': oeuvre.id}) }}">Voir</a>
                    <a href="{{ path('app_oeuvre_edit', {'id': oeuvre.id}) }}">Éditer</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Pas d’entrées trouvées</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_oeuvre_new') }}">Nouvelle œuvre</a>
{% endblock %}
