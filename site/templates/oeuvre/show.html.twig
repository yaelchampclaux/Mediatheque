{% extends 'base.html.twig' %}

{% block title %}Œuvre{% endblock %}

{% block body %}
    <h1>Détail de l’œuvre</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Identifiant</th>
                <td>{{ oeuvre.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ oeuvre.titre }}</td>
            </tr>
            <tr>
                <th>Photo</th>
                <td>{{ oeuvre.photo }}</td>
            </tr>
            <tr>
                <th>Année</th>
                <td>{{ oeuvre.annee }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_oeuvre_index') }}">Retour à la liste</a>

    <a href="{{ path('app_oeuvre_edit', {'id': oeuvre.id}) }}">Éditer</a>

    {{ include('oeuvre/_delete_form.html.twig') }}
{% endblock %}
